# Public app origin; replace with your real HTTPS origin on the VPS.
BETTER_AUTH_URL=http://localhost:3000
# Generate a persistent secret; see docs/Phase 1 Setup.md. Never commit .env.
BETTER_AUTH_SECRET=
# Google OAuth Web application credentials (server-only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Plain SQLite filesystem path, relative to the project root or absolute.
# The parent directory is created if permitted; keep it on persistent VPS storage.
DATABASE_URL=./data/relay.db
